# Copie para .env (ignorado pelo git) e gere os segredos como no README. Nada disto vale para
# outro ambiente: e a stack efemera do benchmark.
PERF_DB_PASSWORD=
PERF_JWT_SECRET=
PERF_CRIPTO_CHAVE=
PERF_SEED_SENHA=
# Imagem do backend, obrigatoria: o SHA em producao na VPS (docker compose images backend) ou agro-perf-backend:local
BACKEND_IMAGE=ghcr.io/supersonicteam/backend:sha-xxxxxxx
K6_VUS=10
K6_DURACAO=3m
