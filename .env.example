# Copie para .env e ajuste. NUNCA versione o .env real (ja esta no .gitignore).

# Profile ativo: dev | prod
SPRING_PROFILES_ACTIVE=dev

# Banco de dados (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=agrocontabil
DB_USER=agrocontabil
DB_PASSWORD=CHANGE_ME

# CORS — origens do frontend separadas por virgula
APP_CORS_ALLOWED_ORIGINS=http://localhost:4200

# Segredo do JWT — usado a partir da Sprint 8 (auth). Gere algo longo e aleatorio.
JWT_SECRET=CHANGE_ME_MIN_32_CHARS

# Certificado digital A1 (.p12) para assinatura da NF-e.
# Em producao use um certificado ICP-Brasil real; NUNCA versione o .p12.
NFE_CERT_PATH=/caminho/seguro/certificado.p12
NFE_CERT_PASSWORD=CHANGE_ME
NFE_CERT_ALIAS=

# OpenAI (integracao futura)
OPENAI_API_KEY=sk-...

# ---------------------------------------------------------------------------
# Pool de conexoes JDBC (HikariCP) e timeouts — issue #98.
# Todos tem default no application.yml; defina aqui so para sobrescrever.
# ---------------------------------------------------------------------------
# Numero maximo de conexoes do pool (default 10).
DB_POOL_SIZE=10
# Conexoes ociosas mantidas prontas (default 2).
DB_POOL_MIN_IDLE=2
# Quanto uma thread espera por conexao livre antes de falhar, em ms (default 5000).
DB_CONNECTION_TIMEOUT_MS=5000
# Tempo ate uma conexao ociosa ser descartada, em ms (default 600000 = 10 min).
DB_IDLE_TIMEOUT_MS=600000
# Vida maxima de uma conexao, em ms (default 1800000 = 30 min).
# Mantenha abaixo de qualquer timeout de firewall/pgbouncer na frente do banco.
DB_MAX_LIFETIME_MS=1800000
# Tempo fora do pool a partir do qual o Hikari loga possivel vazamento, em ms (default 30000).
# Atencao: valores abaixo de 2000 sao IGNORADOS pelo Hikari, e o valor precisa ser MENOR que
# DB_MAX_LIFETIME_MS — caso contrario a deteccao e desativada silenciosamente.
DB_LEAK_DETECTION_MS=30000
# Timeout da validacao de conexao, em ms (default 3000).
DB_VALIDATION_TIMEOUT_MS=3000
# Teto de duracao de transacoes sem timeout explicito (default 30s). Aceita sufixo (s/m).
DB_TX_TIMEOUT=30s
# statement_timeout do PostgreSQL, em ms (default 30000). Só vale nos profiles dev/prod —
# o driver H2 dos testes rejeita esta propriedade.
DB_STATEMENT_TIMEOUT_MS=30000

# ---------------------------------------------------------------------------
# Scheduler e encerramento da aplicacao — issue #101.
# ---------------------------------------------------------------------------
# Threads do scheduler (default 3 — uma por job). Com 1, os jobs voltam a se serializar.
SCHEDULER_POOL_SIZE=3
# Quanto o scheduler espera o job em andamento terminar no shutdown (default 30s).
SCHEDULER_SHUTDOWN_TIMEOUT=30s
# Teto de transacao do job de guias vencidas, em SEGUNDOS (default 600 = 10 min). Ele atualiza
# todas as vencidas numa unica transacao, entao nao pode herdar o DB_TX_TIMEOUT de 30s.
GUIA_FISCAL_SYNC_TX_TIMEOUT=600
# Fechamento mensal da apuracao (issue #100): produtores lidos em lotes deste tamanho, cada um
# fechado em transacao propria (herda o DB_TX_TIMEOUT). Default 100.
APURACAO_FECHAMENTO_LOTE_TAMANHO=100
# Lock distribuido dos jobs entre instancias (issue #87, ShedLock), em duracao ISO-8601.
# AT_MOST_FOR: teto; o lock expira sozinho se a instancia morrer no meio do job.
# AT_LEAST_FOR: piso; impede outra replica de rodar o mesmo job logo em seguida.
NFE_SEFAZ_SYNC_LOCK_AT_MOST_FOR=PT14M
NFE_SEFAZ_SYNC_LOCK_AT_LEAST_FOR=PT10M
APURACAO_FECHAMENTO_LOCK_AT_MOST_FOR=PT50M
APURACAO_FECHAMENTO_LOCK_AT_LEAST_FOR=PT5M
GUIA_FISCAL_SYNC_LOCK_AT_MOST_FOR=PT30M
GUIA_FISCAL_SYNC_LOCK_AT_LEAST_FOR=PT5M

# Janela de cada fase do encerramento graceful, incluindo requisicoes em voo (default 30s).
# Se aumentar, ajuste tambem o stop_grace_period do compose (hoje 35s), senao o Docker
# mata o processo antes de a janela terminar.
SHUTDOWN_TIMEOUT=30s
