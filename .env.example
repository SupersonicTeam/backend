# Copie para .env e ajuste. NUNCA versione o .env real (ja esta no .gitignore).

# Profile de ambiente: dev | homolog | prod. OBRIGATORIO: sem ele a aplicacao recusa a subida
# (issue #219; nao ha mais default dev, nem no compose — #221). Auxiliares acompanham:
# dev,ingestao / dev,avaliacao. So dev aceita o X-Usuario-Id do mock; homolog e prod, so o login.
SPRING_PROFILES_ACTIVE=dev

# Banco de dados (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=agrocontabil
DB_USER=agrocontabil
# Obrigatoria tambem em dev (#225): o application-dev.yml nao tem mais senha padrao.
DB_PASSWORD=CHANGE_ME

# CORS — origens do frontend separadas por virgula
APP_CORS_ALLOWED_ORIGINS=http://localhost:4200

# Segredo do JWT de acesso (#206): aleatorio, >= 32 bytes. Gere com: openssl rand -base64 48
# Obrigatorio em homolog/prod: a aplicacao nao sobe sem ele, com placeholder conhecido (CHANGE_ME,
# "troque", "secret"...), com segredo publicado (o do profile test, o antigo default do compose de
# orquestracao) nem com menos de 16 caracteres distintos (#222). Em dev, vazio ou placeholder =
# segredo efemero gerado na subida (tokens morrem a cada reinicio).
JWT_SECRET=CHANGE_ME_MIN_32_CHARS
# Chave AES-256 dos dados pessoais em repouso (#147): openssl rand -base64 32. Obrigatoria fora de
# dev; perder a chave e perder os dados pessoais do banco.
CRIPTO_CHAVE=
# Validade do token de acesso (ISO-8601, padrao PT15M).
JWT_VALIDADE=PT15M
# Senha das contas semeadas em dev/homolog (#206). Vazio = seed sem credencial (so X-Usuario-Id).
SEED_SENHA=
# Custo do BCrypt (#205, padrao 12). Nao baixar em producao.
SENHA_BCRYPT_CUSTO=12

# Certificado digital A1 (.p12) para assinatura da NF-e.
# Em producao use um certificado ICP-Brasil real; NUNCA versione o .p12. Certificado autoassinado
# (o de teste, default so do dev) gera WARN na subida (#225).
NFE_CERT_PATH=/caminho/seguro/certificado.p12
NFE_CERT_PASSWORD=CHANGE_ME
NFE_CERT_ALIAS=
# Transporte SEFAZ real (issue #128): mock desligado exige enderecos e truststore ICP-Brasil.
NFE_SEFAZ_MOCK_ENABLED=true
NFE_SEFAZ_TRUSTSTORE_PATH=
NFE_SEFAZ_TRUSTSTORE_PASSWORD=
# APP_NFE_SEFAZ_WEBSERVICES_HOMOLOGACAO_PADRAO_AUTORIZACAO=https://...
# APP_NFE_SEFAZ_WEBSERVICES_HOMOLOGACAO_PADRAO_CONSULTA=https://...
# APP_NFE_SEFAZ_WEBSERVICES_HOMOLOGACAO_PADRAO_EVENTO=https://...

# ---------------------------------------------------------------------------
# Ceres — assistente fiscal (issue #141). Todos tem default no application.yml.
# ---------------------------------------------------------------------------
# Provedor do modelo de chat: ollama (local, padrao) | openai (qualquer API compativel com a da
# OpenAI — OpenAI, Maritaca...). Trocar e so configuracao.
AI_CHAT_PROVIDER=ollama
# Modelo de chat. Ollama: qwen3:4b-instruct (padrao). Use variantes "instruct" (sem raciocinio): a
# tag qwen3:4b e a variante "thinking" e ignora think=false. API: o nome do modelo do provedor.
AI_CHAT_MODEL=qwen3:4b-instruct
# Endereco do Ollama. O compose "full" usa http://ollama:11434.
AI_OLLAMA_BASE_URL=http://localhost:11434
# Porta publicada do Ollama (sempre em 127.0.0.1 — o Ollama nao tem autenticacao).
AI_OLLAMA_PORT=11434
# never (padrao): os modelos sao baixados pelo servico ollama-init do compose.
# when_missing: o backend baixa na subida (bloqueia a subida e falha com o Ollama fora do ar).
AI_OLLAMA_PULL_STRATEGY=never
# Provedor por API (so com AI_CHAT_PROVIDER=openai). NUNCA versione a chave real.
AI_API_KEY=
AI_API_BASE_URL=https://api.openai.com
# Caminho do endpoint de chat. OpenAI: /v1/chat/completions (padrao). Confira no provedor.
AI_API_COMPLETIONS_PATH=/v1/chat/completions
# Timeouts das chamadas ao modelo (aceitam sufixo s/m). Modelo local em CPU e lento: leitura alta.
AI_CONNECT_TIMEOUT=5s
AI_READ_TIMEOUT=120s
# Teto GERAL de tokens gerados (padrao do provedor e teto de saida da reserva da cota, #166) e
# janela de contexto do Ollama. Se o contexto estourar, o Ollama descarta o inicio do prompt, onde
# ficam as regras da Ceres.
AI_MAX_TOKENS=1024
AI_OLLAMA_NUM_CTX=8192
# Teto de tokens gerados por tipo de chamada (#270), cada um <= AI_MAX_TOKENS e <= metade do
# contexto (fora disso a aplicacao nao sobe). Resposta cortada no teto e descartada, nunca entregue
# pela metade. Escolha das funcoes de dados (so o JSON), classificacao (JSON, inclusive a
# perguntaLei do MISTO) e resposta de lei.
AI_TETO_FUNCOES=512
AI_TETO_CLASSIFICACAO=256
AI_TETO_LEGISLACAO=1024
# Raciocinio (thinking) do modelo local: false (padrao), true, low, medium, high; vazio = nao enviar
# (modelos sem suporte). Ligado, consome o teto de tokens e multiplica a latencia.
AI_OLLAMA_THINK=false
# Tentativas por chamada ao modelo (1 = sem retry).
AI_RETRY_MAX_ATTEMPTS=2
# Health do Ollama no Actuator: timeout da consulta e janela de cache do resultado.
AI_HEALTH_TIMEOUT=2s
AI_HEALTH_CACHE=10s
# Teto de rodadas modelo -> funcao por pergunta (1 a 10) e perguntas simultaneas (acima: 429).
AI_MAX_RODADAS_FERRAMENTAS=3
AI_MAX_CONVERSAS_SIMULTANEAS=4

# ---------------------------------------------------------------------------
# Pool de conexoes JDBC (HikariCP) e timeouts — issue #98.
# Todos tem default no application.yml; defina aqui so para sobrescrever.
# ---------------------------------------------------------------------------
# Numero maximo de conexoes do pool (default 10).
DB_POOL_SIZE=10
# Conexoes ociosas mantidas prontas (default 2).
DB_POOL_MIN_IDLE=2
# Quanto uma thread espera por conexao livre antes de falhar, em ms (default 5000).
DB_CONNECTION_TIMEOUT_MS=5000
# Tempo ate uma conexao ociosa ser descartada, em ms (default 600000 = 10 min).
DB_IDLE_TIMEOUT_MS=600000
# Vida maxima de uma conexao, em ms (default 1800000 = 30 min).
# Mantenha abaixo de qualquer timeout de firewall/pgbouncer na frente do banco.
DB_MAX_LIFETIME_MS=1800000
# Tempo fora do pool a partir do qual o Hikari loga possivel vazamento, em ms (default 30000).
# Atencao: valores abaixo de 2000 sao IGNORADOS pelo Hikari, e o valor precisa ser MENOR que
# DB_MAX_LIFETIME_MS — caso contrario a deteccao e desativada silenciosamente.
DB_LEAK_DETECTION_MS=30000
# Timeout da validacao de conexao, em ms (default 3000).
DB_VALIDATION_TIMEOUT_MS=3000
# Teto de duracao de transacoes sem timeout explicito (default 30s). Aceita sufixo (s/m).
DB_TX_TIMEOUT=30s
# statement_timeout do PostgreSQL, em ms (default 30000). Só vale nos profiles dev/prod —
# o driver H2 dos testes rejeita esta propriedade.
DB_STATEMENT_TIMEOUT_MS=30000

# ---------------------------------------------------------------------------
# Scheduler e encerramento da aplicacao — issue #101.
# ---------------------------------------------------------------------------
# Threads do scheduler (default 3 — uma por job). Com 1, os jobs voltam a se serializar.
SCHEDULER_POOL_SIZE=3
# Quanto o scheduler espera o job em andamento terminar no shutdown (default 30s).
SCHEDULER_SHUTDOWN_TIMEOUT=30s
# Teto de transacao do job de guias vencidas, em SEGUNDOS (default 600 = 10 min). Ele atualiza
# todas as vencidas numa unica transacao, entao nao pode herdar o DB_TX_TIMEOUT de 30s.
GUIA_FISCAL_SYNC_TX_TIMEOUT=600
# Fechamento mensal da apuracao (issue #100): produtores lidos em lotes deste tamanho, cada um
# fechado em transacao propria (herda o DB_TX_TIMEOUT). Default 100.
APURACAO_FECHAMENTO_LOTE_TAMANHO=100
# Lock distribuido dos jobs entre instancias (issue #87, ShedLock), em duracao ISO-8601.
# AT_MOST_FOR: teto; o lock expira sozinho se a instancia morrer no meio do job.
# AT_LEAST_FOR: piso; impede outra replica de rodar o mesmo job logo em seguida.
NFE_SEFAZ_SYNC_LOCK_AT_MOST_FOR=PT14M
NFE_SEFAZ_SYNC_LOCK_AT_LEAST_FOR=PT10M
APURACAO_FECHAMENTO_LOCK_AT_MOST_FOR=PT50M
APURACAO_FECHAMENTO_LOCK_AT_LEAST_FOR=PT5M
GUIA_FISCAL_SYNC_LOCK_AT_MOST_FOR=PT30M
GUIA_FISCAL_SYNC_LOCK_AT_LEAST_FOR=PT5M

# ---------------------------------------------------------------------------
# SEFAZ: rede e sincronizacao de pendentes — issue #83.
# ---------------------------------------------------------------------------
# Timeouts do transporte real (o mock ignora). Estourar o de CONEXAO significa que nada saiu
# (retry seguro); estourar o de LEITURA significa que a SEFAZ pode ter processado (consulta pela
# chave, nunca reenvio).
NFE_SEFAZ_CONNECT_TIMEOUT_MS=10000
NFE_SEFAZ_READ_TIMEOUT_MS=30000
# A aplicacao NAO sobe se este valor nao superar o pior caso de uma transmissao:
# 2 x [RETRY_MAX_ATTEMPTS x (CONNECT + READ) + (RETRY_MAX_ATTEMPTS - 1) x RETRY_BACKOFF].
# Com os padroes: 2 x (3 x 40s + 2s) = 244s < 600s.
NFE_SEFAZ_TRANSMISSAO_TIMEOUT_MS=600000
# Job de pendentes: IDs lidos por lote (keyset) e falhas de comunicacao seguidas que encerram a
# execucao (SEFAZ fora do ar). Com os padroes o job para em ~10 min, abaixo do lock de 14 min.
NFE_SEFAZ_SYNC_LOTE_TAMANHO=100
NFE_SEFAZ_SYNC_MAX_FALHAS=5

# Janela de cada fase do encerramento graceful, incluindo requisicoes em voo (default 30s).
# Se aumentar, ajuste tambem o stop_grace_period do compose (hoje 35s), senao o Docker
# mata o processo antes de a janela terminar.
SHUTDOWN_TIMEOUT=30s

# ---------------------------------------------------------------------------
# Forca bruta (#208). Limites por IP por minuto e bloqueio por conta.
# ---------------------------------------------------------------------------
LIMITE_LOGIN_POR_MINUTO=10
LIMITE_CADASTRO_POR_MINUTO=5
LIMITE_REFRESH_POR_MINUTO=30
LIMITE_SENHA_POR_MINUTO=5
# Limite geral da API (#150), por usuario autenticado (ou IP) por minuto.
LIMITE_GERAL_POR_MINUTO=100
LIMITE_CHAT_POR_MINUTO=20
FORCA_BRUTA_MAX_FALHAS=5
FORCA_BRUTA_BLOQUEIO=PT15M
# Em prod o IP do cliente vem do X-Forwarded-For do Nginx (server.forward-headers-strategy=native).
# O Tomcat so aceita esse header de proxies "internos" (por padrao: 10/8, 172.16/12, 192.168/16,
# 127/8, 169.254/16, 100.64/10 e equivalentes IPv6). Fixe aqui o endereco REAL do Nginx (regex) e
# publique o backend so na rede interna/loopback: se a porta 8080 ficar alcancavel sem passar pelo
# Nginx, um cliente visto com IP de rede interna forjaria o X-Forwarded-For e escaparia do limite.
# O Nginx deve usar proxy_set_header X-Forwarded-For $remote_addr (nao repassar o do cliente).
# SERVER_TOMCAT_REMOTEIP_INTERNAL_PROXIES=172\.17\.0\.1

# ---------------------------------------------------------------------------
# Recuperacao de senha (#209). SMTP em prod; LOG so em dev (a aplicacao NAO sobe com LOG em prod).
# ---------------------------------------------------------------------------
EMAIL_MODO=DESLIGADO
EMAIL_REMETENTE=nao-responda@agroconia.local
REDEFINICAO_URL_FRONTEND=http://localhost:4200/redefinir-senha
REDEFINICAO_VALIDADE=PT30M
# Com EMAIL_MODO=SMTP (propriedades padrao do Spring Boot):
# SPRING_MAIL_HOST=smtp.exemplo.com
# SPRING_MAIL_PORT=587
# SPRING_MAIL_USERNAME=
# SPRING_MAIL_PASSWORD=
# SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=true
