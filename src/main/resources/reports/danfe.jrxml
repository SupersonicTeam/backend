    </band>
  </columnHeader>

  <!-- =====================================================================
       Detalhe — uma linha por item (a descricao longa estica a linha toda)
       ===================================================================== -->
  <detail>
    <band height="13" splitType="Prevent">
      <textField isBlankWhenNull="true"><reportElement style="LinhaItem" stretchType="RelativeToTallestObject" x="0"   y="0" width="40"  height="13"/><textFieldExpression><![CDATA[$F{codigo}]]></textFieldExpression></textField>
      <textField isBlankWhenNull="true" textAdjust="StretchHeight"><reportElement style="LinhaItem" stretchType="RelativeToTallestObject" x="40"  y="0" width="130" height="13"/><textFieldExpression><![CDATA[$F{descricao}]]></textFieldExpression></textField>
      <textField isBlankWhenNull="true"><reportElement style="LinhaItem" stretchType="RelativeToTallestObject" x="170" y="0" width="42"  height="13"/><textElement textAlignment="Center"/><textFieldExpression><![CDATA[$F{ncm}]]></textFieldExpression></textField>
      <textField isBlankWhenNull="true"><reportElement style="LinhaItem" stretchType="RelativeToTallestObject" x="212" y="0" width="26"  height="13"/><textElement textAlignment="Center"/><textFieldExpression><![CDATA[$F{cfop}]]></textFieldExpression></textField>
      <textField isBlankWhenNull="true"><reportElement style="LinhaItem" stretchType="RelativeToTallestObject" x="238" y="0" width="22"  height="13"/><textElement textAlignment="Center"/><textFieldExpression><![CDATA[$F{unidade}]]></textFieldExpression></textField>
      <textField isBlankWhenNull="true"><reportElement style="LinhaItem" stretchType="RelativeToTallestObject" x="260" y="0" width="40"  height="13"/><textElement textAlignment="Right"/><textFieldExpression><![CDATA[$F{quantidade}]]></textFieldExpression></textField>
      <textField isBlankWhenNull="true"><reportElement style="LinhaItem" stretchType="RelativeToTallestObject" x="300" y="0" width="45"  height="13"/><textElement textAlignment="Right"/><textFieldExpression><![CDATA[$F{valorUnitario}]]></textFieldExpression></textField>
      <textField isBlankWhenNull="true"><reportElement style="LinhaItem" stretchType="RelativeToTallestObject" x="345" y="0" width="50"  height="13"/><textElement textAlignment="Right"/><textFieldExpression><![CDATA[$F{valorTotal}]]></textFieldExpression></textField>
      <textField isBlankWhenNull="true"><reportElement style="LinhaItem" stretchType="RelativeToTallestObject" x="395" y="0" width="28"  height="13"/><textElement textAlignment="Right"/><textFieldExpression><![CDATA[$F{aliquotaIbs}]]></textFieldExpression></textField>
      <textField isBlankWhenNull="true"><reportElement style="LinhaItem" stretchType="RelativeToTallestObject" x="423" y="0" width="42"  height="13"/><textElement textAlignment="Right"/><textFieldExpression><![CDATA[$F{valorIbs}]]></textFieldExpression></textField>
      <textField isBlankWhenNull="true"><reportElement style="LinhaItem" stretchType="RelativeToTallestObject" x="465" y="0" width="28"  height="13"/><textElement textAlignment="Right"/><textFieldExpression><![CDATA[$F{aliquotaCbs}]]></textFieldExpression></textField>
      <textField isBlankWhenNull="true"><reportElement style="LinhaItem" stretchType="RelativeToTallestObject" x="493" y="0" width="42"  height="13"/><textElement textAlignment="Right"/><textFieldExpression><![CDATA[$F{valorCbs}]]></textFieldExpression></textField>
    </band>
  </detail>

  <!-- =====================================================================
       Rodape da pagina
       ===================================================================== -->
  <pageFooter>
    <band height="16" splitType="Stretch">
      <line>
        <reportElement x="0" y="2" width="535" height="1"/>
        <graphicElement>
          <pen lineWidth="0.5" lineColor="#7A8A80"/>
        </graphicElement>
      </line>
      <textField isBlankWhenNull="true">
        <reportElement x="0" y="5" width="400" height="10" forecolor="#4A5A50"/>
        <textElement><font fontName="SansSerif" size="6" isItalic="true"/></textElement>
        <textFieldExpression><![CDATA["AgroContábil — documento gerado em " + $P{GERADO_EM} + ". A validade da NF-e é confirmada na SEFAZ pela chave de acesso."]]></textFieldExpression>
      </textField>
      <textField evaluationTime="Auto">
        <reportElement x="400" y="5" width="135" height="10" forecolor="#4A5A50"/>
        <textElement textAlignment="Right"><font fontName="SansSerif" size="6"/></textElement>
        <textFieldExpression><![CDATA["Página " + $V{PAGINA_ATUAL} + " de " + $V{PAGE_NUMBER}]]></textFieldExpression>
      </textField>
    </band>
  </pageFooter>

  <!-- =====================================================================
       Dados adicionais (uma vez, depois do ultimo item)
       ===================================================================== -->
  <summary>
    <band height="84" splitType="Prevent">
      <staticText>
        <reportElement style="Secao" x="0" y="8" width="535" height="10"/>
        <text><![CDATA[DADOS ADICIONAIS]]></text>
      </staticText>
      <frame>
        <reportElement style="Celula" x="0" y="18" width="355" height="64"/>
        <staticText>
          <reportElement style="Rotulo" x="3" y="2" width="349" height="7"/>
          <text><![CDATA[INFORMAÇÕES COMPLEMENTARES]]></text>
        </staticText>
        <textField isBlankWhenNull="true" textAdjust="ScaleFont">
          <reportElement x="3" y="11" width="349" height="50"/>
          <textElement><font fontName="SansSerif" size="6.5"/></textElement>
          <textFieldExpression><![CDATA[$P{INFO_COMPLEMENTAR}]]></textFieldExpression>
        </textField>
      </frame>
      <frame>
        <reportElement style="Celula" x="355" y="18" width="180" height="64"/>
        <staticText>
          <reportElement style="Rotulo" x="3" y="2" width="174" height="7"/>
          <text><![CDATA[RESERVADO AO FISCO]]></text>
        </staticText>
      </frame>
    </band>
  </summary>


</jasperReport>
