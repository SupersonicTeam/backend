<?xml version="1.0" encoding="UTF-8"?>
<!-- DANFE - NF-e modelo 55 / NFA no leiaute de referencia RETRATO da NT 2026.010 v1.00
     (DANFE Reforma Tributaria, issue #279): quadros do DANFE atual (MOC) preservados, CRT e o
     campo reservado do tipo de regime de apuracao no emitente, bloco TOTAL DO IBS / CBS / IS
     logo apos o TOTAL DO ICMS/IPI e, por item, CST/CFOP, cClassTrib, base e aliquota/valor de
     CBS, IBS UF e IBS Municipio (aliquota efetiva quando ha gRed).
     Quadros facultativos (item 4.4: fatura/duplicatas, transportador, ISSQN, monofasicos, FCP,
     DIFAL) ficam de fora: o XML gerado nao os tem, e a NT proibe imprimir informacao
     inexistente no XML. O Imposto Seletivo (IS) tambem nao esta no XML: o campo sai vazio.
     Toda formatacao vem pronta do DanfePdfService; o template so posiciona texto. -->
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports
                http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="danfe"
              pageWidth="595"
              pageHeight="842"
              columnWidth="535"
              leftMargin="30"
              rightMargin="30"
              topMargin="20"
              bottomMargin="20"
              whenNoDataType="AllSectionsNoDetail">

  <style name="Celula" mode="Transparent">
    <box>
      <pen lineWidth="0.5" lineColor="#7A8A80"/>
    </box>
  </style>
  <style name="Rotulo" fontName="SansSerif" fontSize="5" isBold="true" forecolor="#4A5A50"/>
  <style name="Valor" fontName="SansSerif" fontSize="8"/>
  <style name="Secao" fontName="SansSerif" fontSize="7" isBold="true" forecolor="#2E7648"/>
  <style name="CabecalhoItem" mode="Opaque" backcolor="#EAF4EE" fontName="SansSerif" fontSize="5.5"
         isBold="true" forecolor="#1F3A2A" vTextAlign="Middle">
    <box leftPadding="2" rightPadding="2">
      <pen lineWidth="0.5" lineColor="#7A8A80"/>
    </box>
  </style>
  <style name="LinhaItem" fontName="SansSerif" fontSize="6.5" vTextAlign="Top">
    <box topPadding="1" leftPadding="2" bottomPadding="1" rightPadding="2">
      <pen lineWidth="0.5" lineColor="#7A8A80"/>
    </box>
  </style>

  <parameter name="LOGO" class="java.lang.String"/>
  <parameter name="NUMERO" class="java.lang.String"/>
  <parameter name="SERIE" class="java.lang.String"/>
  <parameter name="MODELO" class="java.lang.String"/>
  <parameter name="TIPO_OPERACAO" class="java.lang.String"/>
  <parameter name="TIPO_DOCUMENTO" class="java.lang.String"/>
  <parameter name="NAT_OPERACAO" class="java.lang.String"/>
  <parameter name="CHAVE_ACESSO" class="java.lang.String"/>
  <parameter name="CONSULTA_CHAVE" class="java.lang.String"/>
  <parameter name="PROTOCOLO" class="java.lang.String"/>
  <parameter name="DATA_EMISSAO" class="java.lang.String"/>
  <parameter name="DATA_SAIDA" class="java.lang.String"/>
  <parameter name="HORA_SAIDA" class="java.lang.String"/>
  <parameter name="SITUACAO" class="java.lang.String"/>
  <parameter name="ORIGEM" class="java.lang.String"/>
  <parameter name="EMIT_NOME" class="java.lang.String"/>
  <parameter name="EMIT_ENDERECO" class="java.lang.String"/>
  <parameter name="EMIT_BAIRRO_CEP" class="java.lang.String"/>
  <parameter name="EMIT_MUNICIPIO_UF" class="java.lang.String"/>
  <parameter name="EMIT_CPF_CNPJ" class="java.lang.String"/>
  <parameter name="EMIT_IE" class="java.lang.String"/>
  <parameter name="EMIT_CRT" class="java.lang.String"/>
  <parameter name="DEST_NOME" class="java.lang.String"/>
  <parameter name="DEST_CPF_CNPJ" class="java.lang.String"/>
  <parameter name="DEST_ENDERECO" class="java.lang.String"/>
  <parameter name="DEST_BAIRRO" class="java.lang.String"/>
  <parameter name="DEST_MUNICIPIO" class="java.lang.String"/>
  <parameter name="DEST_UF" class="java.lang.String"/>
  <parameter name="DEST_CEP" class="java.lang.String"/>
  <parameter name="DEST_IE" class="java.lang.String"/>
  <parameter name="TOTAL_PRODUTOS" class="java.lang.String"/>
  <parameter name="TOTAL_NOTA" class="java.lang.String"/>
  <parameter name="ZERO" class="java.lang.String"/>
  <parameter name="TOTAL_CBS" class="java.lang.String"/>
  <parameter name="TOTAL_IBS_UF" class="java.lang.String"/>
  <parameter name="TOTAL_IBS_MUN" class="java.lang.String"/>
  <parameter name="INFO_COMPLEMENTAR" class="java.lang.String"/>
  <parameter name="GERADO_EM" class="java.lang.String"/>
  <parameter name="MARCA_DAGUA" class="java.lang.String"/>

  <field name="descricao" class="java.lang.String"/>
  <field name="cstCfop" class="java.lang.String"/>
  <field name="quantidadeUnidade" class="java.lang.String"/>
  <field name="valorUnitario" class="java.lang.String"/>
  <field name="valorTotal" class="java.lang.String"/>
  <field name="baseIbsCbs" class="java.lang.String"/>
  <field name="aliquotas" class="java.lang.String"/>
  <field name="valores" class="java.lang.String"/>

  <!-- Pagina atual: avaliada no fim de cada pagina (resetType Page), enquanto PAGE_NUMBER, no
       textField com evaluationTime="Auto", e avaliada no fim do relatorio = total de paginas.
       PAGE_COUNT nao serve: e a contagem de REGISTROS da pagina. -->
  <variable name="PAGINA_ATUAL" class="java.lang.Integer" resetType="Page">
    <variableExpression><![CDATA[$V{PAGE_NUMBER}]]></variableExpression>
  </variable>

  <!-- Marca d'agua do preview (issue #89), so quando MARCA_DAGUA vem preenchido. -->
  <background>
    <band height="802" splitType="Stretch">
      <textField isBlankWhenNull="true">
        <reportElement x="207" y="0" width="120" height="802" forecolor="#D0D0D0">
          <printWhenExpression><![CDATA[$P{MARCA_DAGUA} != null]]></printWhenExpression>
        </reportElement>
        <textElement textAlignment="Center" verticalAlignment="Middle" rotation="Left">
          <font fontName="SansSerif" size="34" isBold="true"/>
        </textElement>
        <textFieldExpression><![CDATA[$P{MARCA_DAGUA}]]></textFieldExpression>
      </textField>
    </band>
  </background>

  <title>
    <band height="384" splitType="Stretch">

      <!-- ===== Canhoto ===== -->
      <frame>
        <reportElement style="Celula" x="0" y="0" width="445" height="14"/>
        <textField isBlankWhenNull="true" textAdjust="ScaleFont">
          <reportElement x="3" y="1" width="439" height="12"/>
          <textElement verticalAlignment="Middle"><font fontName="SansSerif" size="5.5"/></textElement>
          <textFieldExpression><![CDATA["RECEBEMOS DE " + ($P{EMIT_NOME} != null ? $P{EMIT_NOME} : "") + " OS PRODUTOS CONSTANTES DA NOTA FISCAL INDICADA AO LADO"]]></textFieldExpression>
        </textField>
      </frame>
      <frame>
        <reportElement style="Celula" x="0" y="14" width="110" height="20"/>
        <staticText>
          <reportElement style="Rotulo" x="3" y="2" width="104" height="7"/>
          <text><![CDATA[DATA DE RECEBIMENTO]]></text>
        </staticText>
      </frame>
      <frame>
        <reportElement style="Celula" x="110" y="14" width="335" height="20"/>
        <staticText>
          <reportElement style="Rotulo" x="3" y="2" width="329" height="7"/>
          <text><![CDATA[IDENTIFICAÇÃO E ASSINATURA DO RECEBEDOR]]></text>
        </staticText>
      </frame>
      <frame>
        <reportElement style="Celula" x="445" y="0" width="90" height="34"/>
        <staticText>
          <reportElement x="2" y="2" width="86" height="10"/>
          <textElement textAlignment="Center"><font fontName="SansSerif" size="8" isBold="true"/></textElement>
          <text><![CDATA[NF-e]]></text>
        </staticText>
        <textField isBlankWhenNull="true">
          <reportElement x="2" y="12" width="86" height="10"/>
          <textElement textAlignment="Center"><font fontName="SansSerif" size="7" isBold="true"/></textElement>
          <textFieldExpression><![CDATA["Nº " + $P{NUMERO}]]></textFieldExpression>
        </textField>
        <textField isBlankWhenNull="true">
          <reportElement x="2" y="22" width="86" height="10"/>
          <textElement textAlignment="Center"><font fontName="SansSerif" size="7"/></textElement>
          <textFieldExpression><![CDATA["Série " + $P{SERIE}]]></textFieldExpression>
        </textField>
      </frame>
      <line>
        <reportElement x="0" y="39" width="535" height="1"/>
        <graphicElement><pen lineWidth="0.5" lineStyle="Dashed" lineColor="#7A8A80"/></graphicElement>
      </line>

      <!-- ===== Emitente, com a logo ===== -->
      <frame>
        <reportElement style="Celula" x="0" y="44" width="250" height="96"/>
        <image scaleImage="RetainShape" hAlign="Center" vAlign="Middle" onErrorType="Blank">
          <reportElement x="4" y="6" width="48" height="48"/>
          <imageExpression><![CDATA[$P{LOGO}]]></imageExpression>
        </image>
        <textField isBlankWhenNull="true" textAdjust="ScaleFont">
          <reportElement x="58" y="4" width="188" height="24"/>
          <textElement verticalAlignment="Middle"><font fontName="SansSerif" size="9" isBold="true"/></textElement>
          <textFieldExpression><![CDATA[$P{EMIT_NOME}]]></textFieldExpression>
        </textField>
        <textField isBlankWhenNull="true" textAdjust="ScaleFont">
          <reportElement style="Valor" x="58" y="30" width="188" height="11"/>
          <textElement><font size="7"/></textElement>
          <textFieldExpression><![CDATA[$P{EMIT_ENDERECO}]]></textFieldExpression>
        </textField>
        <textField isBlankWhenNull="true" textAdjust="ScaleFont">
          <reportElement style="Valor" x="58" y="41" width="188" height="11"/>
          <textElement><font size="7"/></textElement>
          <textFieldExpression><![CDATA[$P{EMIT_BAIRRO_CEP}]]></textFieldExpression>
        </textField>
        <textField isBlankWhenNull="true" textAdjust="ScaleFont">
          <reportElement style="Valor" x="58" y="52" width="188" height="11"/>
          <textElement><font size="7"/></textElement>
          <textFieldExpression><![CDATA[$P{EMIT_MUNICIPIO_UF}]]></textFieldExpression>
        </textField>
        <staticText>
          <reportElement x="4" y="72" width="242" height="20" forecolor="#4A5A50"/>
          <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="SansSerif" size="5.5" isItalic="true"/></textElement>
          <text><![CDATA[Emitido com o AgroContábil — gestão fiscal do produtor rural]]></text>
        </staticText>
      </frame>
      <!-- ===== DANFE ===== -->
      <frame>
        <reportElement style="Celula" x="250" y="44" width="95" height="96"/>
        <staticText>
          <reportElement x="2" y="1" width="91" height="20"/>
          <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="SansSerif" size="13" isBold="true"/></textElement>
          <text><![CDATA[DANFE]]></text>
        </staticText>
        <staticText>
          <reportElement x="2" y="21" width="91" height="16"/>
          <textElement textAlignment="Center"><font fontName="SansSerif" size="5.5"/></textElement>
          <text><![CDATA[Documento Auxiliar da Nota Fiscal Eletrônica]]></text>
        </staticText>
        <textField isBlankWhenNull="true">
          <reportElement x="2" y="38" width="91" height="12"/>
          <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="SansSerif" size="8" isBold="true"/></textElement>
          <textFieldExpression><![CDATA[$P{TIPO_OPERACAO}]]></textFieldExpression>
        </textField>
        <textField isBlankWhenNull="true">
          <reportElement x="2" y="54" width="91" height="12"/>
          <textElement textAlignment="Center"><font fontName="SansSerif" size="8" isBold="true"/></textElement>
          <textFieldExpression><![CDATA["Nº " + $P{NUMERO}]]></textFieldExpression>
        </textField>
        <textField isBlankWhenNull="true">
          <reportElement x="2" y="66" width="91" height="11"/>
          <textElement textAlignment="Center"><font fontName="SansSerif" size="7"/></textElement>
          <textFieldExpression><![CDATA["Série " + $P{SERIE} + " · Modelo " + $P{MODELO}]]></textFieldExpression>
        </textField>
        <textField evaluationTime="Auto">
          <reportElement x="2" y="78" width="91" height="11"/>
          <textElement textAlignment="Center"><font fontName="SansSerif" size="7"/></textElement>
          <textFieldExpression><![CDATA["Folha " + $V{PAGINA_ATUAL} + "/" + $V{PAGE_NUMBER}]]></textFieldExpression>
        </textField>
      </frame>
      <!-- ===== Chave de acesso ===== -->
      <frame>
        <reportElement style="Celula" x="345" y="44" width="190" height="96"/>
        <staticText>
          <reportElement style="Rotulo" x="3" y="3" width="184" height="8"/>
          <text><![CDATA[CHAVE DE ACESSO]]></text>
        </staticText>
        <textField isBlankWhenNull="true" textAdjust="ScaleFont">
          <reportElement x="3" y="18" width="184" height="14"/>
          <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="SansSerif" size="6.5" isBold="true"/></textElement>
          <textFieldExpression><![CDATA[$P{CHAVE_ACESSO}]]></textFieldExpression>
        </textField>
        <textField isBlankWhenNull="true">
          <reportElement x="3" y="44" width="184" height="48"/>
          <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="SansSerif" size="6"/></textElement>
          <textFieldExpression><![CDATA[$P{CONSULTA_CHAVE}]]></textFieldExpression>
        </textField>
      </frame>
      <frame>
        <reportElement style="Celula" x="0" y="140" width="345" height="22"/>
        <staticText>
          <reportElement style="Rotulo" x="3" y="2" width="339" height="7"/>
          <text><![CDATA[NATUREZA DA OPERAÇÃO]]></text>
        </staticText>
        <textField isBlankWhenNull="true" textAdjust="ScaleFont">
          <reportElement style="Valor" x="3" y="9" width="339" height="12"/>
          <textFieldExpression><![CDATA[$P{NAT_OPERACAO}]]></textFieldExpression>
        </textField>
      </frame>
      <frame>
        <reportElement style="Celula" x="345" y="140" width="190" height="22"/>
        <staticText>
          <reportElement style="Rotulo" x="3" y="2" width="184" height="7"/>
          <text><![CDATA[PROTOCOLO DE AUTORIZAÇÃO DE USO]]></text>
        </staticText>
        <textField isBlankWhenNull="true" textAdjust="ScaleFont">
          <reportElement style="Valor" x="3" y="9" width="184" height="12"/>
          <textFieldExpression><![CDATA[$P{PROTOCOLO}]]></textFieldExpression>
        </textField>
      </frame>
      <frame>
        <reportElement style="Celula" x="0" y="162" width="178" height="22"/>
        <staticText>
          <reportElement style="Rotulo" x="3" y="2" width="172" height="7"/>
          <text><![CDATA[INSCRIÇÃO ESTADUAL]]></text>
        </staticText>
        <textField isBlankWhenNull="true" textAdjust="ScaleFont">
          <reportElement style="Valor" x="3" y="9" width="172" height="12"/>
          <textFieldExpression><![CDATA[$P{EMIT_IE}]]></textFieldExpression>
        </textField>
      </frame>
      <frame>
        <reportElement style="Celula" x="178" y="162" width="178" height="22"/>
        <staticText>
          <reportElement style="Rotulo" x="3" y="2" width="172" height="7"/>
          <text><![CDATA[INSCRIÇÃO ESTADUAL DO SUBST. TRIBUTÁRIO]]></text>
        </staticText>
        <textField isBlankWhenNull="true" textAdjust="ScaleFont">
          <reportElement style="Valor" x="3" y="9" width="172" height="12"/>
          <textFieldExpression><![CDATA[""]]></textFieldExpression>
        </textField>
      </frame>
      <frame>
        <reportElement style="Celula" x="356" y="162" width="179" height="22"/>
        <staticText>
          <reportElement style="Rotulo" x="3" y="2" width="173" height="7"/>
          <text><![CDATA[CNPJ / CPF]]></text>
        </staticText>
        <textField isBlankWhenNull="true" textAdjust="ScaleFont">
          <reportElement style="Valor" x="3" y="9" width="173" height="12"/>
          <textFieldExpression><![CDATA[$P{EMIT_CPF_CNPJ}]]></textFieldExpression>
        </textField>
      </frame>
      <!-- NT 2026.010, item 4.2: CRT (C21) e o tipo de regime de apuracao do IBS/CBS, campo
           reservado que fica vazio enquanto nao houver tag no XML. -->
      <frame>
        <reportElement style="Celula" x="0" y="184" width="267" height="22"/>
        <staticText>
          <reportElement style="Rotulo" x="3" y="2" width="261" height="7"/>
          <text><![CDATA[CÓDIGO DE REGIME TRIBUTÁRIO (CRT)]]></text>
        </staticText>
        <textField isBlankWhenNull="true" textAdjust="ScaleFont">
          <reportElement style="Valor" x="3" y="9" width="261" height="12"/>
          <textFieldExpression><![CDATA[$P{EMIT_CRT}]]></textFieldExpression>
        </textField>
      </frame>
      <frame>
        <reportElement style="Celula" x="267" y="184" width="268" height="22"/>
        <staticText>
          <reportElement style="Rotulo" x="3" y="2" width="262" height="7"/>
          <text><![CDATA[TIPO DE REGIME DE APURAÇÃO DO IBS/CBS]]></text>
        </staticText>
      </frame>
      <staticText>
        <reportElement style="Secao" x="0" y="210" width="535" height="10"/>
        <text><![CDATA[DESTINATÁRIO / REMETENTE]]></text>
      </staticText>
      <frame>
        <reportElement style="Celula" x="0" y="220" width="300" height="22"/>
        <staticText>
          <reportElement style="Rotulo" x="3" y="2" width="294" height="7"/>
          <text><![CDATA[NOME / RAZÃO SOCIAL]]></text>
        </staticText>
        <textField isBlankWhenNull="true" textAdjust="ScaleFont">
          <reportElement style="Valor" x="3" y="9" width="294" height="12"/>
          <textFieldExpression><![CDATA[$P{DEST_NOME}]]></textFieldExpression>
        </textField>
      </frame>
      <frame>
        <reportElement style="Celula" x="300" y="220" width="125" height="22"/>
        <staticText>
          <reportElement style="Rotulo" x="3" y="2" width="119" height="7"/>
          <text><![CDATA[CNPJ / CPF]]></text>
        </staticText>
        <textField isBlankWhenNull="true" textAdjust="ScaleFont">
          <reportElement style="Valor" x="3" y="9" width="119" height="12"/>
          <textFieldExpression><![CDATA[$P{DEST_CPF_CNPJ}]]></textFieldExpression>
        </textField>
      </frame>
      <frame>
        <reportElement style="Celula" x="425" y="220" width="110" height="22"/>
        <staticText>
          <reportElement style="Rotulo" x="3" y="2" width="104" height="7"/>
          <text><![CDATA[DATA DA EMISSÃO]]></text>
        </staticText>
        <textField isBlankWhenNull="true" textAdjust="ScaleFont">
          <reportElement style="Valor" x="3" y="9" width="104" height="12"/>
          <textFieldExpression><![CDATA[$P{DATA_EMISSAO}]]></textFieldExpression>
        </textField>
      </frame>
      <frame>
        <reportElement style="Celula" x="0" y="242" width="210" height="22"/>
        <staticText>
          <reportElement style="Rotulo" x="3" y="2" width="204" height="7"/>
          <text><![CDATA[ENDEREÇO]]></text>
        </staticText>
        <textField isBlankWhenNull="true" textAdjust="ScaleFont">
          <reportElement style="Valor" x="3" y="9" width="204" height="12"/>
          <textFieldExpression><![CDATA[$P{DEST_ENDERECO}]]></textFieldExpression>
        </textField>
      </frame>
      <frame>
        <reportElement style="Celula" x="210" y="242" width="120" height="22"/>
        <staticText>
          <reportElement style="Rotulo" x="3" y="2" width="114" height="7"/>
          <text><![CDATA[BAIRRO / DISTRITO]]></text>
        </staticText>
        <textField isBlankWhenNull="true" textAdjust="ScaleFont">
          <reportElement style="Valor" x="3" y="9" width="114" height="12"/>
          <textFieldExpression><![CDATA[$P{DEST_BAIRRO}]]></textFieldExpression>
        </textField>
      </frame>
      <frame>
        <reportElement style="Celula" x="330" y="242" width="95" height="22"/>
        <staticText>
          <reportElement style="Rotulo" x="3" y="2" width="89" height="7"/>
          <text><![CDATA[CEP]]></text>
        </staticText>
        <textField isBlankWhenNull="true" textAdjust="ScaleFont">
          <reportElement style="Valor" x="3" y="9" width="89" height="12"/>
          <textFieldExpression><![CDATA[$P{DEST_CEP}]]></textFieldExpression>
        </textField>
      </frame>
      <frame>
        <reportElement style="Celula" x="425" y="242" width="110" height="22"/>
        <staticText>
          <reportElement style="Rotulo" x="3" y="2" width="104" height="7"/>
          <text><![CDATA[DATA DA SAÍDA / ENTRADA]]></text>
        </staticText>
        <textField isBlankWhenNull="true" textAdjust="ScaleFont">
          <reportElement style="Valor" x="3" y="9" width="104" height="12"/>
          <textFieldExpression><![CDATA[$P{DATA_SAIDA}]]></textFieldExpression>
        </textField>
      </frame>
      <frame>
        <reportElement style="Celula" x="0" y="264" width="185" height="22"/>
        <staticText>
          <reportElement style="Rotulo" x="3" y="2" width="179" height="7"/>
          <text><![CDATA[MUNICÍPIO]]></text>
        </staticText>
        <textField isBlankWhenNull="true" textAdjust="ScaleFont">
          <reportElement style="Valor" x="3" y="9" width="179" height="12"/>
          <textFieldExpression><![CDATA[$P{DEST_MUNICIPIO}]]></textFieldExpression>
        </textField>
      </frame>
      <frame>
        <reportElement style="Celula" x="185" y="264" width="90" height="22"/>
        <staticText>
          <reportElement style="Rotulo" x="3" y="2" width="84" height="7"/>
          <text><![CDATA[FONE / FAX]]></text>
        </staticText>
      </frame>
      <frame>
        <reportElement style="Celula" x="275" y="264" width="30" height="22"/>
        <staticText>
          <reportElement style="Rotulo" x="3" y="2" width="24" height="7"/>
          <text><![CDATA[UF]]></text>
        </staticText>
        <textField isBlankWhenNull="true" textAdjust="ScaleFont">
          <reportElement style="Valor" x="3" y="9" width="24" height="12"/>
          <textFieldExpression><![CDATA[$P{DEST_UF}]]></textFieldExpression>
        </textField>
      </frame>
      <frame>
        <reportElement style="Celula" x="305" y="264" width="120" height="22"/>
        <staticText>
          <reportElement style="Rotulo" x="3" y="2" width="114" height="7"/>
          <text><![CDATA[INSCRIÇÃO ESTADUAL]]></text>
        </staticText>
        <textField isBlankWhenNull="true" textAdjust="ScaleFont">
          <reportElement style="Valor" x="3" y="9" width="114" height="12"/>
          <textFieldExpression><![CDATA[$P{DEST_IE}]]></textFieldExpression>
        </textField>
      </frame>
      <frame>
        <reportElement style="Celula" x="425" y="264" width="110" height="22"/>
        <staticText>
          <reportElement style="Rotulo" x="3" y="2" width="104" height="7"/>
          <text><![CDATA[HORA DA SAÍDA / ENTRADA]]></text>
        </staticText>
        <textField isBlankWhenNull="true" textAdjust="ScaleFont">
          <reportElement style="Valor" x="3" y="9" width="104" height="12"/>
          <textFieldExpression><![CDATA[$P{HORA_SAIDA}]]></textFieldExpression>
        </textField>
