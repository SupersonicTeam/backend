<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.27.xsd">

    <!-- ================================================================
         0033-credencial-bloqueio.xml
         Sprint 8 — issue #208 (protecao do login contra forca bruta).

         falhas_login conta as senhas erradas seguidas; ao atingir o
         limite (5, por propriedade), bloqueada_ate trava a conta por um
         tempo (15 min). Durante o bloqueio a senha nem e conferida — a
         adivinhacao para. Login com sucesso zera o contador.

         Colunas novas na credencial, nao tabela propria: o bloqueio e
         estado da conta, lido no mesmo SELECT do login.
         ================================================================ -->

    <changeSet id="0033-credencial-bloqueio" author="supersonic-team">
        <comment>
            Adiciona falhas_login e bloqueada_ate a credencial_usuario.
        </comment>

        <addColumn tableName="credencial_usuario">
            <column name="falhas_login" type="INTEGER" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="bloqueada_ate" type="TIMESTAMP WITH TIME ZONE"/>
        </addColumn>

        <rollback>
            <dropColumn tableName="credencial_usuario" columnName="bloqueada_ate"/>
            <dropColumn tableName="credencial_usuario" columnName="falhas_login"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
