    <!-- ================================================================
         Seed de CFOP de saída relevantes ao produtor rural + alguns de
         entrada/inaplicáveis para exercitar a regra de aplicabilidade.
         ================================================================ -->
    <changeSet id="0007-seed-cfop-referencia" author="supersonic-team">
        <!-- Saídas internas (5xxx) aplicáveis ao produtor rural -->
        <insert tableName="cfop_referencia">
            <column name="codigo" value="5101"/>
            <column name="descricao" value="Venda de producao do estabelecimento (operacao interna)"/>
            <column name="tipo_operacao" value="SAIDA"/>
            <column name="ambito" value="INTERNO"/>
            <column name="aplicavel_produtor_rural" valueBoolean="true"/>
        </insert>
        <insert tableName="cfop_referencia">
            <column name="codigo" value="5102"/>
            <column name="descricao" value="Venda de mercadoria adquirida de terceiros (operacao interna)"/>
            <column name="tipo_operacao" value="SAIDA"/>
            <column name="ambito" value="INTERNO"/>
            <column name="aplicavel_produtor_rural" valueBoolean="true"/>
        </insert>
        <insert tableName="cfop_referencia">
            <column name="codigo" value="5901"/>
            <column name="descricao" value="Remessa para industrializacao por encomenda (interna)"/>
            <column name="tipo_operacao" value="SAIDA"/>
            <column name="ambito" value="INTERNO"/>
            <column name="aplicavel_produtor_rural" valueBoolean="true"/>
        </insert>
        <insert tableName="cfop_referencia">
            <column name="codigo" value="5949"/>
            <column name="descricao" value="Outra saida de mercadoria ou prestacao de servico nao especificada (interna)"/>
            <column name="tipo_operacao" value="SAIDA"/>
            <column name="ambito" value="INTERNO"/>
            <column name="aplicavel_produtor_rural" valueBoolean="true"/>
        </insert>
        <!-- Saídas interestaduais (6xxx) aplicáveis ao produtor rural -->
        <insert tableName="cfop_referencia">
            <column name="codigo" value="6101"/>
            <column name="descricao" value="Venda de producao do estabelecimento (operacao interestadual)"/>
            <column name="tipo_operacao" value="SAIDA"/>
            <column name="ambito" value="INTERESTADUAL"/>
            <column name="aplicavel_produtor_rural" valueBoolean="true"/>
        </insert>
        <insert tableName="cfop_referencia">
            <column name="codigo" value="6102"/>
            <column name="descricao" value="Venda de mercadoria adquirida de terceiros (operacao interestadual)"/>
            <column name="tipo_operacao" value="SAIDA"/>
            <column name="ambito" value="INTERESTADUAL"/>
            <column name="aplicavel_produtor_rural" valueBoolean="true"/>
        </insert>
        <insert tableName="cfop_referencia">
            <column name="codigo" value="6949"/>
            <column name="descricao" value="Outra saida de mercadoria ou prestacao de servico nao especificada (interestadual)"/>
            <column name="tipo_operacao" value="SAIDA"/>
            <column name="ambito" value="INTERESTADUAL"/>
            <column name="aplicavel_produtor_rural" valueBoolean="true"/>
        </insert>
        <!-- Saída para o exterior (7xxx) aplicável ao produtor rural -->
        <insert tableName="cfop_referencia">
            <column name="codigo" value="7101"/>
            <column name="descricao" value="Venda de producao do estabelecimento (exportacao)"/>
            <column name="tipo_operacao" value="SAIDA"/>
            <column name="ambito" value="EXTERIOR"/>
            <column name="aplicavel_produtor_rural" valueBoolean="true"/>
        </insert>
        <!-- CFOP de entrada/industrializacao: existe na tabela mas NAO e aplicavel ao
             produtor rural na emissao de saida — exercita a regra de aplicabilidade. -->
        <insert tableName="cfop_referencia">
            <column name="codigo" value="1556"/>
            <column name="descricao" value="Compra de material para uso ou consumo (operacao interna)"/>
            <column name="tipo_operacao" value="ENTRADA"/>
            <column name="ambito" value="INTERNO"/>
            <column name="aplicavel_produtor_rural" valueBoolean="false"/>
        </insert>
        <rollback>
            <delete tableName="cfop_referencia"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
