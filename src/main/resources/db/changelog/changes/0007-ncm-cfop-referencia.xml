<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.27.xsd">

    <!-- ================================================================
         0007-ncm-cfop-referencia.xml
         Sprint 2 — issue #20 (RN008): tabelas de referência de NCM e CFOP
         do agronegócio + seed curado. Usadas pelos validadores de existência
         (@ValidNcm/@ValidCfop) na camada de entrada (HTTP 400).

         Subconjunto curado e versionado — NÃO é o catálogo oficial completo
         de NCM/CFOP; suficiente para o escopo do TCC.
         ================================================================ -->

    <changeSet id="0007-create-ncm-agropecuario" author="supersonic-team">
        <createTable tableName="ncm_agropecuario">
            <column name="codigo" type="VARCHAR(8)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="descricao" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <rollback>
            <dropTable tableName="ncm_agropecuario"/>
        </rollback>
    </changeSet>

    <changeSet id="0007-create-cfop-referencia" author="supersonic-team">
        <createTable tableName="cfop_referencia">
            <column name="codigo" type="VARCHAR(4)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="descricao" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="tipo_operacao" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="ambito" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="aplicavel_produtor_rural" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <rollback>
            <dropTable tableName="cfop_referencia"/>
        </rollback>
    </changeSet>

