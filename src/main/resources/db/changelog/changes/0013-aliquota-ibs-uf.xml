        </rollback>
    </changeSet>

    <changeSet id="0013-nota-fiscal-item-add-ibs-uf-mun" author="supersonic-team">
        <comment>
            Adiciona as parcelas estadual/municipal reais de IBS por item:
            aliquota_ibs_uf/aliquota_ibs_mun (parcelas da aliquota) e
            valor_ibs_uf/valor_ibs_mun (parcelas do valor). Gravadas pelo
            TributacaoService a partir de aliquota_ibs_uf; consumidas pelo
            NotaFiscalNfeMapper no lugar da antiga divisao 50/50. Nullable:
            itens gravados antes desta sprint nao possuem as parcelas.
        </comment>

        <addColumn tableName="nota_fiscal_item">
            <column name="aliquota_ibs_uf" type="NUMERIC(7,4)">
                <constraints nullable="true"/>
            </column>
            <column name="aliquota_ibs_mun" type="NUMERIC(7,4)">
                <constraints nullable="true"/>
            </column>
            <column name="valor_ibs_uf" type="NUMERIC(15,2)">
                <constraints nullable="true"/>
            </column>
            <column name="valor_ibs_mun" type="NUMERIC(15,2)">
                <constraints nullable="true"/>
            </column>
        </addColumn>

        <rollback>
            <dropColumn tableName="nota_fiscal_item" columnName="aliquota_ibs_uf"/>
            <dropColumn tableName="nota_fiscal_item" columnName="aliquota_ibs_mun"/>
            <dropColumn tableName="nota_fiscal_item" columnName="valor_ibs_uf"/>
            <dropColumn tableName="nota_fiscal_item" columnName="valor_ibs_mun"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
