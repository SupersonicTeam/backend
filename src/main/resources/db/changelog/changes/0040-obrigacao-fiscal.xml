<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.27.xsd">

    <!-- ================================================================
         0040-obrigacao-fiscal.xml
         Issue #181 (obrigacoes no calendario fiscal).

         Catalogo de obrigacoes acessorias e recolhimentos, por escritorio.
         Linhas com escritorio_id NULL e modelo = true sao os MODELOS do
         sistema, semeados aqui: valem para todo escritorio ate ele mexer.
         Editar um modelo cria a versao do escritorio (escritorio_id +
         modelo_id), que vale no lugar dele so para aquele escritorio;
         desativar = versao com ativa = false; "restaurar padrao" apaga a
         versao. Modelo novo num changeSet futuro chega a quem nao
         personalizou, e a correcao de um modelo nao passa por cima da
         personalizacao de ninguem.

         regimes_tributarios: lista separada por virgula (ex. PRESUMIDO,REAL);
         vazio = todos. tipo_produtor NULL = todos. Feriados fora da v1: so
         o fim de semana e ajustado. Dia inexistente no mes cai no ultimo.

         Os ids dos modelos sao fixos, para changeSets futuros os
         referenciarem. Datas a conferir com o contador do grupo antes do
         merge (decisoes-por-issue.md, #181).
         ================================================================ -->

    <changeSet id="0040-create-obrigacao-fiscal" author="supersonic-team">
        <comment>Cria obrigacao_fiscal (modelos do sistema e catalogo de cada escritorio).</comment>

        <createTable tableName="obrigacao_fiscal">
            <column name="id" type="UUID">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="escritorio_id" type="UUID"/>
            <column name="modelo" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="modelo_id" type="UUID"/>
            <column name="titulo" type="VARCHAR(120)">
                <constraints nullable="false"/>
            </column>
            <column name="descricao" type="VARCHAR(500)"/>
            <column name="periodicidade" type="VARCHAR(10)">
                <constraints nullable="false"/>
            </column>
            <column name="dia" type="INTEGER">
                <constraints nullable="false"/>
            </column>
            <column name="mes" type="INTEGER"/>
            <column name="ajuste_fim_de_semana" type="VARCHAR(10)" defaultValue="NENHUM">
                <constraints nullable="false"/>
            </column>
            <column name="tipo_produtor" type="VARCHAR(20)"/>
            <column name="regimes_tributarios" type="VARCHAR(60)"/>
            <column name="origem" type="VARCHAR(200)"/>
            <column name="ativa" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE"/>
            <column name="updated_at" type="TIMESTAMP WITH TIME ZONE"/>
        </createTable>

        <addForeignKeyConstraint baseTableName="obrigacao_fiscal" baseColumnNames="escritorio_id"
                constraintName="fk_obrigacao_fiscal_escritorio"
                referencedTableName="escritorio" referencedColumnNames="id" onDelete="CASCADE"/>
        <!-- Modelo retirado num changeSet futuro: a versao do escritorio fica como obrigacao propria. -->
        <addForeignKeyConstraint baseTableName="obrigacao_fiscal" baseColumnNames="modelo_id"
                constraintName="fk_obrigacao_fiscal_modelo"
                referencedTableName="obrigacao_fiscal" referencedColumnNames="id"
                onDelete="SET NULL"/>

        <createIndex tableName="obrigacao_fiscal" indexName="idx_obrigacao_fiscal_escritorio">
            <column name="escritorio_id"/>
        </createIndex>

        <rollback>
            <dropTable tableName="obrigacao_fiscal"/>
        </rollback>
    </changeSet>

    <changeSet id="0040-obrigacao-fiscal-regras" author="supersonic-team" dbms="postgresql">
        <comment>
            Uma versao por modelo e escritorio; dominio das colunas fechadas (o H2 dos testes nao
            tem indice parcial: la a regra fica so no servico).
        </comment>
        <sql>
            CREATE UNIQUE INDEX uk_obrigacao_fiscal_versao
                ON obrigacao_fiscal (escritorio_id, modelo_id) WHERE modelo_id IS NOT NULL;
            ALTER TABLE obrigacao_fiscal ADD CONSTRAINT ck_obrigacao_fiscal_dono CHECK (
                (modelo AND escritorio_id IS NULL AND modelo_id IS NULL)
                OR (NOT modelo AND escritorio_id IS NOT NULL));
            ALTER TABLE obrigacao_fiscal ADD CONSTRAINT ck_obrigacao_fiscal_prazo CHECK (
                dia BETWEEN 1 AND 31
                AND ((periodicidade = 'MENSAL' AND mes IS NULL)
                  OR (periodicidade = 'ANUAL' AND mes BETWEEN 1 AND 12)));
        </sql>
        <rollback>
            <sql>
                DROP INDEX uk_obrigacao_fiscal_versao;
                ALTER TABLE obrigacao_fiscal DROP CONSTRAINT ck_obrigacao_fiscal_dono;
                ALTER TABLE obrigacao_fiscal DROP CONSTRAINT ck_obrigacao_fiscal_prazo;
            </sql>
        </rollback>
    </changeSet>

