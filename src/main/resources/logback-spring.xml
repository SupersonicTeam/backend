<?xml version="1.0" encoding="UTF-8"?>
<!--
  Logging do AgroContabil (LGPD, issue #148).

  Igual ao padrao do Spring Boot (base.xml: console, arquivo opcional, niveis do application.yml),
  com uma diferenca: a mensagem de log (%m / %msg / %message) passa pela mascara de dados pessoais
  - CPF, CNPJ, e-mail e telefone viram [CPF], [CNPJ], [EMAIL], [TELEFONE] em qualquer log.
  As regras precisam vir antes do include, para valer nos padroes que ele define.
-->
<configuration>
  <conversionRule conversionWord="m"
                  converterClass="br.com.agrocontabil.config.MensagemLogMascaradaConverter"/>
  <conversionRule conversionWord="msg"
                  converterClass="br.com.agrocontabil.config.MensagemLogMascaradaConverter"/>
  <conversionRule conversionWord="message"
                  converterClass="br.com.agrocontabil.config.MensagemLogMascaradaConverter"/>
  <include resource="org/springframework/boot/logging/logback/base.xml"/>
</configuration>
