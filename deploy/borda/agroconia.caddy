# AgroConIA na borda da VPS (GWNexT-Technologies/infra-borda). Instalado em
# /opt/borda/sites/agroconia.caddy pelo scripts/instalar-inquilino.sh da borda (valida, nome
# temporario + mv, reload); nunca escrito direto na pasta: um arquivo invalido derruba a borda
# inteira no proximo reinicio. A borda aceita uma LISTA DE PERMITIDOS: diretiva nova aqui pode
# exigir PR la antes (confira com o scripts/validar-inquilino.sh).
#
# So blocos de site, com os dominios literais: sem opcao global, sem porta, sem snippet, sem import
# e sem variavel de ambiente. O roteamento e do agroconia-caddy (deploy/caddy/Caddyfile). Daqui sao
# o TLS e o HSTS. Na parte global da borda fica so o "ask" (o Caddy aceita um por instancia):
#   on_demand_tls { ask http://agroconia-caddy:8081/interno/tls/permitido?chave=... }

www.agroconia.com.br {
	# AS DUAS LINHAS DE tls SAO OBRIGATORIAS por causa do curinga abaixo (Caddy 2.10.2):
	# - sem "force_automate", o Caddy considera o www coberto pelo *.agroconia.com.br e nao emite o
	#   certificado proprio dele;
	# - so com ela, qualquer outro bloco no arquivo da borda (o redirect abaixo, o site de outro
	#   inquilino) faz o www cair na politica sob demanda do curinga: o certificado passa a
	#   depender do "ask", que recusa o www, e o site cai.
	# O bloco com key_type (P-256 ja e o padrao: o certificado nao muda) da ao www uma politica
	# propria, antes da do curinga. O deploy/ensaio-borda/ensaio.sh confere as duas coisas: rode-o
	# de novo ao mudar a imagem do Caddy ou estes blocos. Outro site num subdominio de
	# agroconia.com.br precisa das mesmas linhas.
	tls force_automate
	tls {
		key_type p256
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}

	reverse_proxy agroconia-caddy:80 {
		flush_interval -1
		# Enquanto o proxy e recriado, tenta por ate 5 s em vez de devolver 502.
		lb_try_duration 5s
	}
}

# Enderecos dos escritorios (#464): um certificado por slug, sob demanda, so com o "ask" do backend
# respondendo 2xx. O curinga limita a este dominio: o catch-all da borda segue neutro.
*.agroconia.com.br {
	tls {
		on_demand
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}

	reverse_proxy agroconia-caddy:80 {
		flush_interval -1
		lb_try_duration 5s
	}
}

# O dominio sem www e o endereco sslip.io antigo redirecionam para o principal.
agroconia.com.br, agrocontabil.167-126-45-181.sslip.io {
	redir https://www.agroconia.com.br{uri} permanent
}
