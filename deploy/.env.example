# Copie para /opt/agrocontabil/.env na VPS (chmod 600). NUNCA versione o .env real.

# Endereco publico. Sem dominio proprio, o sslip.io resolve <ip-com-hifens>.sslip.io para o IP e o
# Caddy tira o certificado HTTPS (Let's Encrypt) sozinho.
SITE_HOST=agrocontabil.167-126-45-181.sslip.io

# Senha do site (basic auth no Caddy). Gere o hash com:
#   docker run --rm caddy:2.10-alpine caddy hash-password --plaintext '<senha>'
# Aspas SIMPLES: o hash tem "$" e o compose tentaria interpolar.
BASIC_AUTH_USER=banca
BASIC_AUTH_HASH='$2a$14$troque-pelo-hash'

# Banco (so na rede interna do compose).
DB_NAME=agrocontabil
DB_USER=agrocontabil
DB_PASSWORD=CHANGE_ME

# Senha das contas semeadas pelo DataLoader (opcional; precisa passar na politica de senha).
SEED_SENHA=

# Tags das imagens no GHCR (latest = ultimo push na main; ou sha-xxxxxxx para fixar).
BACKEND_TAG=latest
FRONTEND_TAG=latest

AI_CHAT_MODEL=qwen3:4b-instruct
