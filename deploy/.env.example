# Copie para /opt/agrocontabil/.env na VPS (chmod 600). NUNCA versione o .env real.

# Endereco publico (dominio da AgroConIA; DNS na Hostinger com registro A para o IP da VPS). O Caddy
# tira o certificado HTTPS (Let's Encrypt) sozinho, depois que o DNS aponta para a VPS.
SITE_HOST=www.agroconia.com.br
# Outros nomes que redirecionam para o SITE_HOST, separados por virgula: o dominio sem www e o
# endereco sslip.io antigo (o sslip.io resolve <ip-com-hifens>.sslip.io para o IP, sem DNS proprio).
SITE_REDIRECIONA=agroconia.com.br, agrocontabil.167-126-45-181.sslip.io

# Segredo do JWT (#206) e chave de cifra dos dados pessoais (#147). Gere com:
#   openssl rand -base64 48   (JWT_SECRET)
#   openssl rand -base64 32   (CRIPTO_CHAVE: 32 bytes em Base64)
# Trocar a CRIPTO_CHAVE deixa ilegiveis os CPFs/e-mails ja gravados: so com o banco zerado.
JWT_SECRET=
CRIPTO_CHAVE=

# Banco (so na rede interna do compose).
DB_NAME=agrocontabil
DB_USER=agrocontabil
DB_PASSWORD=CHANGE_ME

# Senha das contas semeadas pelo DataLoader (opcional; precisa passar na politica de senha).
SEED_SENHA=

# Tags das imagens no GHCR (latest = ultimo push na main; ou sha-xxxxxxx para fixar).
BACKEND_TAG=latest
FRONTEND_TAG=latest

# Modelo de chat. Para testar o Q4_0 (#270, item 1), siga docs/ceres-assistente.md (secao
# "Quantizacao Q4_0") e troque so esta variavel. O padrao segue o qwen3:4b-instruct (Q4_K_M).
AI_CHAT_MODEL=qwen3:4b-instruct
# Claude pela API da Anthropic em vez do Ollama: descomente as tres linhas (a chave precisa estar
# ligada a um workspace e fica so aqui, .env 600) e rode `docker compose up -d backend`. O Ollama
# segue no ar para o embedding (bge-m3). Reverter: comente de novo e suba o backend.
# AI_CHAT_PROVIDER=anthropic
# AI_CHAT_MODEL=claude-haiku-5-5
# ANTHROPIC_API_KEY=

# Janela de contexto do Ollama (minimo 6144; tambem o teto de entrada por chamada da cota), teto
# geral (AI_MAX_TOKENS: padrao do provedor) e teto de tokens gerados por tipo de chamada (#270),
# que a reserva da cota soma (#166). Cada teto fica <= metade do contexto; fora disso o backend nao
# sobe. Com o raciocinio ligado, suba os tetos junto. Candidatos a
# medir na VPS (harness da #264), nunca sem medicao: AI_TETO_LEGISLACAO=512 e AI_OLLAMA_NUM_CTX=6144
# (so se o maior prompt medido ficar abaixo de ~5.000 tokens).
AI_OLLAMA_NUM_CTX=8192
AI_MAX_TOKENS=1024
AI_TETO_FUNCOES=512
AI_TETO_CLASSIFICACAO=256
AI_TETO_LEGISLACAO=1024
