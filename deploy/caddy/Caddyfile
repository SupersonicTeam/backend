# agroconia-caddy: o proxy do AgroConIA atras da borda da VPS (GWNexT-Technologies/infra-borda).
# So HTTP, sem porta publicada e sem certificado: TLS, HTTP/3, HSTS, o certificado sob demanda e o
# "ask" sao da borda (o bloco do AgroConIA nela e o deploy/borda/agroconia.caddy). O roteamento da
# aplicacao fica aqui. Mudou algo: validar e recarregar (deploy/README.md, "Borda e proxy").
{
	auto_https off

	# API de administracao so no proprio container: aberta na rede borda, qualquer container de outro
	# sistema reconfiguraria este proxy. Ligada (e nao "off") por causa do "caddy reload".
	admin localhost:2019

	# So o Caddy da borda (IP fixo na rede "borda") pode dizer quem e o visitante: dele os
	# X-Forwarded-For/-Proto/-Host sao preservados; de qualquer outro, reescritos. NUNCA a faixa
	# inteira: um container de outro inquilino forjaria o IP e furaria o limite por IP (#208).
	servers {
		trusted_proxies static 172.31.255.2/32
	}
}

# O que todo site da aplicacao serve: API no backend, os quadros da jornada da landing do disco (so
# imagem e JSON, publicados pela equipe) e o resto no frontend. E o mesmo SPA em todo host: o
# subdominio nunca serve conteudo enviado pelo cliente (#464).
(app) {
	encode zstd gzip

	# Sem senha no proxy: o backend roda em homolog, onde so o JWT do login autentica (o mock do
	# X-Usuario-Id existe so em dev, #221). Cada cabecalho sai de um lugar so: o HSTS e da borda,
	# estes sao daqui.
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		-Server
	}

	# API direto no backend (sem o Actuator: so /api e publico). SSE da Ceres sai sem buffer. O
	# backend so aceita os X-Forwarded-* de proxy interno (server.forward-headers-strategy=native).
	handle /api/* {
		reverse_proxy backend:8080 {
			flush_interval -1
		}
	}

	# Quadros da jornada 3D da landing (frontend#174): pacote versionado em /opt/agrocontabil/jornada,
	# fora da imagem do frontend (81 MB em cada imagem). A versao vai no caminho (/jornada/v0.1/...),
	# por isso o cache de um ano; pacote novo entra como v0.2, nunca por cima.
	# So sai arquivo que existe, e so imagem e JSON: a pasta e servida na origem do app, em todo host,
	# e um .html ali rodaria com a sessao de quem o abrisse (#464). O resto e 404 pelo respond, que
	# leva os cabecalhos do snippet e nenhum Cache-Control: a falta de um arquivo (pacote ainda nao
	# copiado) nao pode ficar um ano no navegador. Publicar: deploy/README.md, Jornada da landing.
	handle_path /jornada/* {
		root * /srv/jornada

		@quadro {
			method GET HEAD
			path *.avif *.webp *.json
			file
		}
		handle @quadro {
			header Cache-Control "public, max-age=31536000, immutable"
			file_server
		}

		handle {
			respond 404
		}
	}

	handle {
		reverse_proxy frontend:80
	}
}

http://{$SITE_HOST} {
	# Acessos da pagina inicial, para contar o QR do cartao de visita (?utm_source=cartao, #484).
	# Minimizado (LGPD), sem dado pessoal: so a raiz "/" entra (nunca /api, que leva CPF/CNPJ na
	# busca, nem o /healthz do monitor, nem as rotas do SPA, cuja query vem da tela) e saem IP,
	# porta, cabecalhos e cookies. Fica data, metodo, host, URI, status, tamanho, duracao e o user
	# agent (separa robo de pessoa). Retencao curta: arquivo de 1 MiB (~3.600 acessos) e 3 antigos
	# compactados, apagados 30 dias depois. Contar: deploy/README.md, secao Acessos.
	log {
		output file /data/acessos/www.log {
			roll_size 1MiB
			roll_keep 3
			roll_keep_for 720h
		}
		format filter {
			wrap json
			fields {
				request>remote_ip delete
				request>remote_port delete
				request>client_ip delete
				request>headers delete
				request>tls delete
				resp_headers delete
				user_id delete
				# Identificadores de clique que redes e anuncios acrescentam ao link: ligam o
				# acesso a um perfil. O utm_source fica (e o que se conta).
				request>uri query {
					delete fbclid
					delete gclid
					delete gbraid
					delete wbraid
					delete msclkid
					delete ttclid
					delete twclid
					delete li_fat_id
					delete igshid
					delete mc_eid
				}
			}
		}
	}
	@foraDaContagem not path /
	log_skip @foraDaContagem
	log_append agente {http.request.header.User-Agent}

	# Monitor externo (UptimeRobot). Responde so UP/DOWN pelo health do backend, sem repassar o
	# corpo: o Actuator nunca sai daqui (so /api e o frontend sao repassados). So no www.
	handle /healthz {
		rewrite * /actuator/health
		reverse_proxy backend:8080 {
			@saudavel status 2xx
			handle_response @saudavel {
				respond "UP" 200
			}
			handle_response {
				respond "DOWN" 503
			}
		}
	}

	import app
}

# Enderecos dos escritorios, {slug}.agroconia.com.br (#464). O certificado e da borda. Host fora do
# dominio base nao tem o que receber aqui.
:80 {
	# O endereco do escritorio nao entra em buscador (frontend#175): toda resposta dele, pagina e
	# API, leva o noindex. Sem o no-referrer do snippet, o slug iria no Referer as fontes externas.
	@escritorio host *.{$SITE_DOMINIO}
	handle @escritorio {
		header X-Robots-Tag "noindex"
		import app
	}

	handle {
		abort
	}
}

# Porta so de rede, para o que nao e trafego de visitante: o "ask" do On-Demand TLS, que a borda
# chama (o backend nao entra na rede borda), e o healthcheck do compose. A borda nunca encaminha
# requisicao publica para ca; a porta 80 acima nunca repassa /interno ao backend.
:8081 {
	handle /ping {
		respond "ok" 200
	}

	handle /interno/tls/permitido {
		reverse_proxy backend:8080
	}

	handle {
		respond 404
	}
}
