# Borda DE ENSAIO, so para o ensaio.sh desta pasta. A de verdade e do repositorio
# GWNexT-Technologies/infra-borda; daqui ela precisa do que esta abaixo: o "ask" do AgroConIA na
# parte global, o catch-all neutro e o import dos inquilinos.
{
	# So no ensaio: certificados de uma CA interna, sem falar com o Let's Encrypt.
	local_certs
	skip_install_trust

	on_demand_tls {
		ask http://agroconia-caddy:8081/interno/tls/permitido?chave={$AGROCONIA_TLS_ASK_CHAVE}
	}
}

# Catch-all neutro: host desconhecido nao ganha certificado, e a conexao e encerrada.
https:// {
	abort
}

import sites/*.caddy
