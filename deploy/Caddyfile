{$SITE_HOST} {
	encode zstd gzip

	# Monitor externo (UptimeRobot). Responde so UP/DOWN pelo health do backend, sem repassar o
	# corpo: o Actuator nunca sai daqui (so /api e o frontend sao repassados).
	handle /healthz {
		rewrite * /actuator/health
		reverse_proxy backend:8080 {
			@saudavel status 2xx
			handle_response @saudavel {
				respond "UP" 200
			}
			handle_response {
				respond "DOWN" 503
			}
		}
	}

	# Sem senha no Caddy: o backend roda em homolog, onde so o JWT do login autentica (o mock do
	# X-Usuario-Id existe so em dev, #221). Quem protege a API e o backend; aqui fica o HTTPS.
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		-Server
	}

	# API direto no backend (sem o Actuator: so /api e publico). SSE da Ceres sai sem buffer.
	handle /api/* {
		reverse_proxy backend:8080 {
			flush_interval -1
		}
	}

	handle {
		reverse_proxy frontend:80
	}
}

# Outros nomes do site (o dominio sem www, o endereco sslip.io antigo): redirecionam para o
# principal, com certificado proprio.
{$SITE_REDIRECIONA} {
	redir https://{$SITE_HOST}{uri} permanent
}
