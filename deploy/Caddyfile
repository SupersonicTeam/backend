# Opcoes globais. On-Demand TLS dos enderecos dos escritorios (#464): antes de pedir o certificado
# de um {slug}.agroconia.com.br, o Caddy pergunta ao backend (rede interna, fora de /api) se o slug
# e de um escritorio. So 2xx emite; o backend so responde 2xx com a chave certa e um slug servido.
# A chave vai na URL: so letras, digitos, hifen e sublinhado (openssl rand -hex 32).
{
	on_demand_tls {
		ask http://backend:8080/interno/tls/permitido?chave={$TLS_ASK_CHAVE}
	}
}

# O que todo site da aplicacao serve: API no backend, o resto no frontend (o mesmo SPA em todo host:
# o subdominio nunca serve conteudo enviado pelo cliente, #464).
(app) {
	encode zstd gzip

	# Sem senha no Caddy: o backend roda em homolog, onde so o JWT do login autentica (o mock do
	# X-Usuario-Id existe so em dev, #221). Quem protege a API e o backend; aqui fica o HTTPS.
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		-Server
	}

	# API direto no backend (sem o Actuator: so /api e publico). SSE da Ceres sai sem buffer. O
	# Caddy repassa o Host original e reescreve o X-Forwarded-Host/-For/-Proto; o backend so os
	# aceita de proxy interno (server.forward-headers-strategy=native).
	handle /api/* {
		reverse_proxy backend:8080 {
			flush_interval -1
		}
	}

	handle {
		reverse_proxy frontend:80
	}
}

{$SITE_HOST} {
	# Acessos da pagina inicial, para contar o QR do cartao de visita (?utm_source=cartao, #484).
	# Minimizado (LGPD), sem dado pessoal: so a raiz "/" entra (nunca /api, que leva CPF/CNPJ na
	# busca, nem o /healthz do monitor, nem as rotas do SPA, cuja query vem da tela) e saem IP,
	# porta, cabecalhos e cookies. Fica data, metodo, host, URI, status, tamanho, duracao e o user
	# agent (separa robo de pessoa). Retencao curta: arquivo de 1 MiB (~3.600 acessos) e 3 antigos
	# compactados, apagados 30 dias depois. Contar e aplicar: deploy/README.md, secao Acessos.
	log {
		output file /data/acessos/www.log {
			roll_size 1MiB
			roll_keep 3
			roll_keep_for 720h
		}
		format filter {
			wrap json
			fields {
				request>remote_ip delete
				request>remote_port delete
				request>client_ip delete
				request>headers delete
				request>tls delete
				resp_headers delete
				user_id delete
				# Identificadores de clique que redes e anuncios acrescentam ao link: ligam o
				# acesso a um perfil. O utm_source fica (e o que se conta).
				request>uri query {
					delete fbclid
					delete gclid
					delete gbraid
					delete wbraid
					delete msclkid
					delete ttclid
					delete twclid
					delete li_fat_id
					delete igshid
					delete mc_eid
				}
			}
		}
	}
	@foraDaContagem not path /
	log_skip @foraDaContagem
	log_append agente {http.request.header.User-Agent}

	# Monitor externo (UptimeRobot). Responde so UP/DOWN pelo health do backend, sem repassar o
	# corpo: o Actuator nunca sai daqui (so /api e o frontend sao repassados). So no www.
	handle /healthz {
		rewrite * /actuator/health
		reverse_proxy backend:8080 {
			@saudavel status 2xx
			handle_response @saudavel {
				respond "UP" 200
			}
			handle_response {
				respond "DOWN" 503
			}
		}
	}

	import app
}

# Enderecos dos escritorios, {slug}.agroconia.com.br (#464): certificado sob demanda, um por slug,
# so com o "ask" do backend respondendo 2xx. Slug inexistente ou reservado (inclusive o www) nunca
# ganha certificado: o handshake falha. Cada slug emitido vai para os registros publicos de
# Certificate Transparency. Mudou algo aqui: CA de staging antes (deploy/README.md).
#
# Site catch-all de proposito, NUNCA *.{$SITE_DOMINIO}: no Caddy 2.10 o site curinga faz o Caddy
# deixar de emitir o certificado proprio do www (ele passa a esperar o certificado curinga, que o
# on_demand nunca emite) e o www cai. Os sites com nome acima continuam mais especificos. Host fora
# do dominio base nem chega aqui (o ask recusa), e o abort e a segunda barreira.
https:// {
	tls {
		on_demand
	}

	# O endereco do escritorio nao entra em buscador (frontend#175): toda resposta dele, pagina e
	# API, leva o noindex. Os outros cabecalhos (HSTS, nosniff, no-referrer) vem do snippet (app),
	# o mesmo do www: sem o no-referrer, o slug iria no Referer as fontes externas.
	@escritorio host *.{$SITE_DOMINIO}
	handle @escritorio {
		header X-Robots-Tag "noindex"
		import app
	}

	handle {
		abort
	}
}

# Outros nomes do site (o dominio sem www, o endereco sslip.io antigo): redirecionam para o
# principal, com certificado proprio.
{$SITE_REDIRECIONA} {
	redir https://{$SITE_HOST}{uri} permanent
}
